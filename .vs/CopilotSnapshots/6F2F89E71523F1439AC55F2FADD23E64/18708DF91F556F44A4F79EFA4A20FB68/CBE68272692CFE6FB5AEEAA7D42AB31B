    ' ==================================================================
    '  Public properties
    ' ==================================================================

    ''' <summary>The last action taken by the user.</summary>
    Public ReadOnly Property LastAction As UserAction
        Get
            Return _action
        End Get
    End Property

    ''' <summary>True once the user clicks Done or Cancel.</summary>
    Public ReadOnly Property IsActionTaken As Boolean
        Get
            Return _actionTaken
        End Get
    End Property

    ''' <summary>Current display mode.</summary>
    Public ReadOnly Property Mode As PanelMode
        Get
            Return _mode
        End Get
    End Property

    ''' <summary>Validated parameters from the last ParameterInput accept.</summary>
    Public ReadOnly Property ResultParameters As GratingParameters
        Get
            Return _resultParams
        End Get
    End Property

    ' ==================================================================
    '  Constructor
    ' ==================================================================

    Public Sub New()
        Me.DoubleBuffered = True
        Me.SetStyle(
            ControlStyles.AllPaintingInWmPaint Or
            ControlStyles.OptimizedDoubleBuffer Or
            ControlStyles.ResizeRedraw Or
            ControlStyles.UserPaint, True)
        Me.UpdateStyles()

        BuildLayout()
        ShowIdleContent()

        ' Redirect mouse-wheel from any focused child control to our
        ' manual scroll handler so the panel scrolls from anywhere.
        _wheelFilter = New WheelRedirector(Me)
        Application.AddMessageFilter(_wheelFilter)
    End Sub

    Protected Overrides Sub Dispose(disposing As Boolean)
        If disposing Then
            If _wheelFilter IsNot Nothing Then
                Application.RemoveMessageFilter(_wheelFilter)
                _wheelFilter = Nothing
            End If
        End If
        MyBase.Dispose(disposing)
    End Sub

    Protected Overrides ReadOnly Property CreateParams As CreateParams
        Get
            Dim cp As CreateParams = MyBase.CreateParams
            cp.ExStyle = cp.ExStyle Or &H2000000  ' WS_EX_COMPOSITED
            Return cp
        End Get
    End Property

    ' ==================================================================
    '  Public mode-switching methods
    ' ==================================================================

    ''' <summary>
    ''' Switches the panel to sketch edit mode with instructions for
    ''' the given sketch name. Resets the action state so the caller
    ''' can poll <see cref="IsActionTaken"/>.
    ''' </summary>
    Public Sub EnterSketchEditMode(sketchName As String)
        _sketchName = sketchName
        _action = UserAction.None
        _actionTaken = False
        _mode = PanelMode.SketchEdit
        ShowSketchEditContent()
    End Sub

    ''' <summary>
    ''' Returns the panel to idle mode. Resets action state.
    ''' </summary>
    Public Sub ResetToIdle()
        _mode = PanelMode.Idle
        _action = UserAction.None
        _actionTaken = False
        ShowIdleContent()
    End Sub

    ''' <summary>
    ''' Switches the panel to parameter input mode pre-populated with
    ''' the given defaults.  Resets the action state so the caller can
    ''' poll <see cref="IsActionTaken"/> and read <see cref="ResultParameters"/>.
    ''' </summary>
    Public Sub EnterParameterInputMode(defaults As GratingParameters)
        _paramDefaults = defaults
        _resultParams = Nothing
        _action = UserAction.None
        _actionTaken = False
        _mode = PanelMode.ParameterInput
        ShowParameterInputContent()
    End Sub

    ''' <summary>
    ''' Switches the panel to progress mode showing the generation
    ''' progress bar.  Call <see cref="UpdateProgress"/> to advance.
    ''' </summary>
    Public Sub EnterProgressMode(Optional title As String = "Generating Grating...")
        _action = UserAction.None
        _actionTaken = False
        _mode = PanelMode.Progress
        ShowProgressContent(title)
    End Sub

    ''' <summary>
    ''' Updates the progress bar value, step text, and optional percentage.
    ''' Safe to call from the UI thread (inside a DoEvents loop).
    ''' </summary>
    Public Sub UpdateProgress(percent As Integer, stepText As String)
        If _mode <> PanelMode.Progress Then Return
        If _progressBar IsNot Nothing Then
            _progressBar.Value = Math.Min(Math.Max(percent, 0), 100)
        End If
        If _lblProgressStep IsNot Nothing Then
            _lblProgressStep.Text = stepText
        End If
    End Sub

    ' ==================================================================
    '  Layout construction
    ' ==================================================================

    Private Sub BuildLayout()
        Me.BackColor = _clrBack
        Me.ForeColor = _clrText
        Me.Dock = DockStyle.Fill
        Me.AutoScroll = False
        Me.Padding = New Padding(0)

        ' Content panel — NOT docked, NOT AutoScroll.
        ' Positioned and scrolled manually to avoid native scrollbar
        ' after-image artifacts inside Inventor DockableWindows.
        _contentPanel = New DoubleBufferedPanel()
        _contentPanel.Location = New Point(0, 0)
        _contentPanel.Size = New Size(Me.ClientSize.Width, Me.ClientSize.Height)
        _contentPanel.AutoScroll = False
        _contentPanel.Padding = New Padding(10, 10, 10, 10)
        _contentPanel.BackColor = _clrBack
        Me.Controls.Add(_contentPanel)

        ' Sync width and clamp scroll when the DockableWindow is resized
        AddHandler Me.Resize, AddressOf OnContainerResize

        ' --- Idle mode controls ---
        _lblIdleTitle = New Label()
        _lblIdleTitle.Text = "Hand Made Grating"
        _lblIdleTitle.Font = New Font(Me.Font.FontFamily, 10.0F, FontStyle.Bold)
        _lblIdleTitle.AutoSize = True
        _lblIdleTitle.ForeColor = _clrText
        _lblIdleTitle.Margin = New Padding(0, 0, 0, 8)

        _lblIdleInfo = New Label()
        _lblIdleInfo.Text =
            "Click ""Create Grating"" on the ribbon to begin." & vbCrLf & vbCrLf &
            "This panel will show workflow instructions " &
            "when a grating operation is in progress."
        _lblIdleInfo.AutoSize = False
        _lblIdleInfo.MaximumSize = New Size(600, 0)
        _lblIdleInfo.AutoSize = True
        _lblIdleInfo.ForeColor = _clrDimText

        ' --- Sketch edit mode controls ---
        _lblEditTitle = New Label()
        _lblEditTitle.Text = "Draw Boundary Perimeter"
        _lblEditTitle.Font = New Font(Me.Font.FontFamily, 10.0F, FontStyle.Bold)
        _lblEditTitle.AutoSize = True
        _lblEditTitle.ForeColor = _clrText
        _lblEditTitle.Margin = New Padding(0, 0, 0, 6)

        _lblEditSketchName = New Label()
        _lblEditSketchName.Text = ""
        _lblEditSketchName.AutoSize = True
        _lblEditSketchName.ForeColor = _clrAccent
        _lblEditSketchName.Margin = New Padding(0, 0, 0, 10)

        _lblEditInstructions = New Label()
        _lblEditInstructions.Text = ""
        _lblEditInstructions.AutoSize = False
        _lblEditInstructions.MaximumSize = New Size(600, 0)
        _lblEditInstructions.AutoSize = True
        _lblEditInstructions.ForeColor = _clrText
        _lblEditInstructions.Margin = New Padding(0, 0, 0, 14)

        _btnDone = New Button()
        _btnDone.Text = "I'm Done"
        _btnDone.Size = New Size(100, 30)
        _btnDone.Margin = New Padding(0, 0, 6, 0)
        StyleButton(_btnDone)
        AddHandler _btnDone.Click, AddressOf OnDoneClick

        _btnCancel = New Button()
        _btnCancel.Text = "Cancel"
        _btnCancel.Size = New Size(80, 30)
        StyleButton(_btnCancel)
        AddHandler _btnCancel.Click, AddressOf OnCancelClick

        ' --- Progress mode controls ---
        _lblProgressTitle = New Label()
        _lblProgressTitle.Text = "Generating Grating..."
        _lblProgressTitle.Font = New Font(Me.Font.FontFamily, 10.0F, FontStyle.Bold)
        _lblProgressTitle.AutoSize = True
        _lblProgressTitle.ForeColor = _clrText

        _lblProgressStep = New Label()
        _lblProgressStep.Text = "Preparing..."
        _lblProgressStep.AutoSize = True
        _lblProgressStep.ForeColor = _clrDimText

        _progressBar = New ProgressBar()
        _progressBar.Minimum = 0
        _progressBar.Maximum = 100
        _progressBar.Value = 0
        _progressBar.Style = ProgressBarStyle.Continuous
        _progressBar.Size = New Size(200, 22)
    End Sub

    ' ==================================================================
    '  Content display helpers
    ' ==================================================================

    Private Sub ShowIdleContent()
        _contentPanel.SuspendLayout()
        _contentPanel.Controls.Clear()

        Dim flow As New FlowLayoutPanel()
        flow.FlowDirection = FlowDirection.TopDown
        flow.WrapContents = False
        flow.AutoSize = True
        flow.Dock = DockStyle.Top
        flow.Padding = New Padding(24, 0, 14, 0)
        flow.BackColor = _clrBack

        flow.Controls.Add(_lblIdleTitle)
        flow.Controls.Add(_lblIdleInfo)

        _contentPanel.Controls.Add(flow)
        _contentPanel.ResumeLayout(True)

        ' No scrolling needed for idle content
        _contentHeight = Me.ClientSize.Height
        _contentPanel.Height = _contentHeight
        _contentPanel.Top = 0
    End Sub

    Private Sub ShowSketchEditContent()
        _contentPanel.SuspendLayout()
        _contentPanel.Controls.Clear()

        _lblEditSketchName.Text = "Sketch: " & _sketchName

        _lblEditInstructions.Text =
            "Draw a closed perimeter that defines the " &
            "grating outline:" & vbCrLf & vbCrLf &
            ChrW(&H2022) & " Use Lines, Arcs, or Splines" & vbCrLf &
            ChrW(&H2022) & " All curves must connect end-to-end" & vbCrLf &
            ChrW(&H2022) & " The loop must be closed" & vbCrLf & vbCrLf &
            "Click ""I'm Done"" when finished."

        Dim flow As New FlowLayoutPanel()
        flow.FlowDirection = FlowDirection.TopDown
        flow.WrapContents = False
        flow.AutoSize = True
        flow.Dock = DockStyle.Top
        flow.Padding = New Padding(24, 0, 14, 0)
        flow.BackColor = _clrBack

        flow.Controls.Add(_lblEditTitle)
        flow.Controls.Add(_lblEditSketchName)
        flow.Controls.Add(_lblEditInstructions)

        Dim buttonFlow As New FlowLayoutPanel()
        buttonFlow.FlowDirection = FlowDirection.LeftToRight
        buttonFlow.AutoSize = True
        buttonFlow.Margin = New Padding(0, 4, 0, 0)
        buttonFlow.BackColor = _clrBack
        buttonFlow.Controls.Add(_btnDone)
        buttonFlow.Controls.Add(_btnCancel)
        flow.Controls.Add(buttonFlow)

        _contentPanel.Controls.Add(flow)
        _contentPanel.ResumeLayout(True)

        ' No scrolling needed for sketch edit content
        _contentHeight = Me.ClientSize.Height
        _contentPanel.Height = _contentHeight
        _contentPanel.Top = 0
    End Sub

    Private Sub ShowProgressContent(title As String)
        _contentPanel.SuspendLayout()
        _contentPanel.Controls.Clear()

        Dim x As Integer = 24
        Dim y As Integer = 14
        Dim anc As AnchorStyles = AnchorStyles.Left Or AnchorStyles.Top Or AnchorStyles.Right
        Dim cw As Integer = Math.Max(100, _contentPanel.ClientSize.Width - 38)

        _lblProgressTitle.Text = title
        _lblProgressTitle.Location = New Point(x, y)
        _contentPanel.Controls.Add(_lblProgressTitle)
        y += 32

        _progressBar.Location = New Point(x, y)
        _progressBar.Size = New Size(cw, 22)
        _progressBar.Anchor = anc
        _progressBar.Value = 0
        _contentPanel.Controls.Add(_progressBar)
        y += 34

        _lblProgressStep.Text = "Preparing..."
        _lblProgressStep.Location = New Point(x, y)
        _lblProgressStep.MaximumSize = New Size(Math.Max(100, cw), 0)
        _contentPanel.Controls.Add(_lblProgressStep)

        _contentPanel.ResumeLayout(True)

        ' No scrolling needed
        _contentHeight = Me.ClientSize.Height
        _contentPanel.Height = _contentHeight
        _contentPanel.Top = 0
    End Sub

