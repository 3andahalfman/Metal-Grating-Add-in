    Private Sub OnParamOKClick(sender As Object, e As EventArgs)
        Dim barDepth As Double
        Dim barWidth As Double
        Dim spacing As Double
        Dim firstOffset As Double

        If Not Double.TryParse(_txtBarDepth.Text.Trim(), barDepth) Then
            ShowParamError("Bar Depth must be a valid number.")
            Return
        End If

        If Not Double.TryParse(_txtBarWidth.Text.Trim(), barWidth) Then
            ShowParamError("Bar Width must be a valid number.")
            Return
        End If

        If Not Double.TryParse(_txtOnCenterSpacing.Text.Trim(), spacing) Then
            ShowParamError("On-Center Spacing must be a valid number.")
            Return
        End If

        If Not Double.TryParse(_txtFirstCrossBarOffset.Text.Trim(), firstOffset) Then
            ShowParamError("First Cross Bar Offset must be a valid number.")
            Return
        End If

        Dim result As New GratingParameters()
        result.SpanDirection = If(_cboSpanDirection.SelectedIndex = 1,
                                  SpanDirectionType.AlongY,
                                  SpanDirectionType.AlongX)
        result.BarDepth = barDepth
        result.BarWidth = barWidth
        result.OnCenterSpacing = spacing
        result.OutputFolder = _txtOutputFolder.Text.Trim()
        result.NamingPrefix = _txtNamingPrefix.Text.Trim()

        result.CrossBar = CType(_cboCrossBarType.SelectedIndex, CrossBarType)

        Dim ocText As String = CStr(_cboCrossBarOC.SelectedItem)
        Dim ocValue As Double
        If Double.TryParse(ocText, ocValue) Then
            result.CrossBarOnCenter = ocValue
        Else
            result.CrossBarOnCenter = 4.0
        End If

        result.FirstCrossBarOffset = firstOffset
        result.SurfaceProfile = CType(_cboSurfaceProfile.SelectedIndex, SurfaceProfileType)
        result.Banding = CType(_cboBanding.SelectedIndex, BandingOptionType)

        ' Parse notch overrides — blank = use default (Nothing)
        Dim nv As Double
        If Not String.IsNullOrWhiteSpace(_txtNotchSlotWidth.Text) Then
            If Not Double.TryParse(_txtNotchSlotWidth.Text.Trim(), nv) OrElse nv <= 0 Then
                ShowParamError("Notch Slot Width must be a positive number (or leave blank for default).")
                Return
            End If
            result.NotchSlotWidthOverride = nv
        End If
        If Not String.IsNullOrWhiteSpace(_txtNotchSlotDepth.Text) Then
            If Not Double.TryParse(_txtNotchSlotDepth.Text.Trim(), nv) OrElse nv <= 0 Then
                ShowParamError("Notch Slot Depth must be a positive number (or leave blank for default).")
                Return
            End If
            result.NotchSlotDepthOverride = nv
        End If
        If Not String.IsNullOrWhiteSpace(_txtNotchStraightDepth.Text) Then
            If Not Double.TryParse(_txtNotchStraightDepth.Text.Trim(), nv) OrElse nv < 0 Then
                ShowParamError("Notch Straight Depth must be zero or positive (or leave blank for default).")
                Return
            End If
            result.NotchStraightDepthOverride = nv
        End If
        If Not String.IsNullOrWhiteSpace(_txtNotchBottomRadius.Text) Then
            If Not Double.TryParse(_txtNotchBottomRadius.Text.Trim(), nv) OrElse nv < 0 Then
                ShowParamError("Notch Bottom Radius must be zero or positive (or leave blank for default).")
                Return
            End If
            result.NotchBottomRadiusOverride = nv
        End If

        ' Parse serration overrides — only when serrated toggle is active
        If _isSerrationActive Then
            If Not String.IsNullOrWhiteSpace(_txtSerrChord.Text) Then
                If Not Double.TryParse(_txtSerrChord.Text.Trim(), nv) OrElse nv <= 0 Then
                    ShowParamError("Scallop Chord must be a positive number (or leave blank for default).")
                    Return
                End If
                result.SerrationChordOverride = nv
            End If
            If Not String.IsNullOrWhiteSpace(_txtSerrFlatWidth.Text) Then
                If Not Double.TryParse(_txtSerrFlatWidth.Text.Trim(), nv) OrElse nv < 0 Then
                    ShowParamError("Flat Width must be zero or positive (or leave blank for default).")
                    Return
                End If
                result.SerrationFlatWidthOverride = nv
            End If
            If Not String.IsNullOrWhiteSpace(_txtSerrArcRadius.Text) Then
                If Not Double.TryParse(_txtSerrArcRadius.Text.Trim(), nv) OrElse nv <= 0 Then
                    ShowParamError("Arc Radius must be a positive number (or leave blank for default).")
                    Return
                End If
                result.SerrationArcRadiusOverride = nv
            End If
            If Not String.IsNullOrWhiteSpace(_txtSerrMargin.Text) Then
                If Not Double.TryParse(_txtSerrMargin.Text.Trim(), nv) OrElse nv < 0 Then
                    ShowParamError("Margin must be zero or positive (or leave blank for default).")
                    Return
                End If
                result.SerrationMarginOverride = nv
            End If
        End If

        Dim errors As List(Of String) = InputValidationService.Validate(result)
        If errors.Count > 0 Then
            ShowParamError(String.Join(vbCrLf, errors))
            Return
        End If

        _resultParams = result
        _action = UserAction.Done
        _actionTaken = True
    End Sub

