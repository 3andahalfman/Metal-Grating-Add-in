    End Sub
End Class

''' <summary>
''' Redirects mouse-wheel messages from any focused child control
''' to <see cref="HmgPanelControl.ScrollContent"/> so the panel
''' scrolls regardless of which control has focus.
''' </summary>
Friend Class WheelRedirector
    Implements IMessageFilter

    Private Const WM_MOUSEWHEEL As Integer = &H20A
    Private ReadOnly _owner As HmgPanelControl

    Public Sub New(owner As HmgPanelControl)
        _owner = owner
    End Sub

    Public Function PreFilterMessage(ByRef m As Message) As Boolean _
            Implements IMessageFilter.PreFilterMessage
        If m.Msg <> WM_MOUSEWHEEL Then Return False
        If Not _owner.IsHandleCreated OrElse _owner.IsDisposed Then Return False

        Dim pt = _owner.PointToClient(Cursor.Position)
        If Not _owner.ClientRectangle.Contains(pt) Then Return False

        Dim delta = CShort(((m.WParam.ToInt64() >> 16) And &HFFFF))
        _owner.ScrollContent(CInt(delta))
        Return True
    End Function
End Class
