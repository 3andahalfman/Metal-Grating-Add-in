    Private Sub PopulateParamDefaults()
        If _paramDefaults Is Nothing Then Return

        _cboSpanDirection.SelectedIndex = If(_paramDefaults.SpanDirection = SpanDirectionType.AlongY, 1, 0)
        _txtBarDepth.Text = _paramDefaults.BarDepth.ToString("G")
        _txtBarWidth.Text = _paramDefaults.BarWidth.ToString("G")
        _txtOnCenterSpacing.Text = _paramDefaults.OnCenterSpacing.ToString("G")
        _txtOutputFolder.Text = If(_paramDefaults.OutputFolder, "")
        _txtNamingPrefix.Text = If(_paramDefaults.NamingPrefix, "Grating")

        Dim cbIdx As Integer = CInt(_paramDefaults.CrossBar)
        If cbIdx >= 0 AndAlso cbIdx < _cboCrossBarType.Items.Count Then
            _cboCrossBarType.SelectedIndex = cbIdx
        Else
            _cboCrossBarType.SelectedIndex = 0
        End If

        _cboCrossBarOC.SelectedIndex = If(Math.Abs(_paramDefaults.CrossBarOnCenter - 2.0) < 0.001, 0, 1)
        _txtFirstCrossBarOffset.Text = _paramDefaults.FirstCrossBarOffset.ToString("G")
        _cboSurfaceProfile.SelectedIndex = CInt(_paramDefaults.SurfaceProfile)
        _cboBanding.SelectedIndex = CInt(_paramDefaults.Banding)

        ' Notch overrides — blank = use default
        _txtNotchSlotWidth.Text = If(_paramDefaults.NotchSlotWidthOverride.HasValue,
            _paramDefaults.NotchSlotWidthOverride.Value.ToString("G"), "")
        _txtNotchSlotDepth.Text = If(_paramDefaults.NotchSlotDepthOverride.HasValue,
            _paramDefaults.NotchSlotDepthOverride.Value.ToString("G"), "")
        _txtNotchStraightDepth.Text = If(_paramDefaults.NotchStraightDepthOverride.HasValue,
            _paramDefaults.NotchStraightDepthOverride.Value.ToString("G"), "")
        _txtNotchBottomRadius.Text = If(_paramDefaults.NotchBottomRadiusOverride.HasValue,
            _paramDefaults.NotchBottomRadiusOverride.Value.ToString("G"), "")

        ' Serration overrides — blank = use default
        _txtSerrChord.Text = If(_paramDefaults.SerrationChordOverride.HasValue,
            _paramDefaults.SerrationChordOverride.Value.ToString("G"), "")
        _txtSerrFlatWidth.Text = If(_paramDefaults.SerrationFlatWidthOverride.HasValue,
            _paramDefaults.SerrationFlatWidthOverride.Value.ToString("G"), "")
        _txtSerrArcRadius.Text = If(_paramDefaults.SerrationArcRadiusOverride.HasValue,
            _paramDefaults.SerrationArcRadiusOverride.Value.ToString("G"), "")
        _txtSerrMargin.Text = If(_paramDefaults.SerrationMarginOverride.HasValue,
            _paramDefaults.SerrationMarginOverride.Value.ToString("G"), "")

        ' Set toggle to match surface profile selection
        _isSerrationActive = (_paramDefaults.SurfaceProfile = SurfaceProfileType.Serrated)
        ApplyProfileToggleState()
    End Sub

