    Private _isSerrationActive As Boolean = False
    Private _isBandingOpen As Boolean = False
    Private _notchSectionCollapsed As Boolean = True

    ' Serration dimension override controls
    Private _lblSerrChord As Label
    Private _txtSerrChord As TextBox
    Private _lblSerrFlatWidth As Label
    Private _txtSerrFlatWidth As TextBox
    Private _lblSerrArcRadius As Label
    Private _txtSerrArcRadius As TextBox
    Private _lblSerrMargin As Label
    Private _txtSerrMargin As TextBox

    ' Progress mode controls
    Private _lblProgressTitle As Label
    Private _lblProgressStep As Label
