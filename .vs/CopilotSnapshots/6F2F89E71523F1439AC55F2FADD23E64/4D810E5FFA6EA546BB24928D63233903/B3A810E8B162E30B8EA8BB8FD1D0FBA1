    ' Summary mode controls
    Private _lblSummaryTitle As Label

    ' Custom scrollbar (avoids native scrollbar after-image artifacts)
    Private _scrollTrack As Panel
    Private _scrollThumb As Panel
    Private _isDraggingThumb As Boolean = False
    Private _thumbDragStartY As Integer
    Private _thumbDragStartTop As Integer

    ' Sticky action button panel (outside scrollable content)
    Private _buttonPanel As DoubleBufferedPanel
    Private Const ButtonPanelHeight As Integer = 46

    ' Bearing Bar O.C. Spacing — spec-defined values
    Private Shared ReadOnly _ocSpacingDisplay() As String = {
        "7/16""", "11/16""", "15/16""", "1-3/16""", "1-3/8""", "1-7/8""", "2-3/8"""
    }
    Private Shared ReadOnly _ocSpacingValues() As Double = {
        0.4375, 0.6875, 0.9375, 1.1875, 1.375, 1.875, 2.375
    }

    ' ==================================================================
    '  Public properties
    ' ==================================================================

    ''' <summary>The last action taken by the user.</summary>
    Public ReadOnly Property LastAction As UserAction
        Get
            Return _action
        End Get
    End Property

    ''' <summary>True once the user clicks Done or Cancel.</summary>
    Public ReadOnly Property IsActionTaken As Boolean
        Get
            Return _actionTaken
        End Get
    End Property

    ''' <summary>Current display mode.</summary>
    Public ReadOnly Property Mode As PanelMode
        Get
            Return _mode
        End Get
    End Property

    ''' <summary>Validated parameters from the last ParameterInput accept.</summary>
    Public ReadOnly Property ResultParameters As GratingParameters
        Get
            Return _resultParams
        End Get
    End Property

    ''' <summary>Project name entered during BoundarySource mode.</summary>
    Public ReadOnly Property ResultProjectName As String
        Get
            Return _resultProjectName
        End Get
    End Property

    ''' <summary>Boundary source type chosen during BoundarySource mode.</summary>
    Public ReadOnly Property ResultSourceType As BoundarySourceType
        Get
            Return _resultSourceType
        End Get
    End Property

    ' ==================================================================
    '  Constructor
    ' ==================================================================

    Public Sub New()
        Me.DoubleBuffered = True
        Me.SetStyle(
            ControlStyles.AllPaintingInWmPaint Or
            ControlStyles.OptimizedDoubleBuffer Or
            ControlStyles.ResizeRedraw Or
            ControlStyles.UserPaint, True)
        Me.UpdateStyles()

        Me.Font = New Font("Segoe UI", 9.0F, FontStyle.Regular)

        BuildLayout()
        ShowIdleContent()

        ' Mouse hook is installed lazily when the panel first needs
        ' scrolling (see EnsureMouseHook).  Installing a system-wide
        ' WH_MOUSE_LL hook at construction time — before the
        ' DockableWindow is even visible — can stall Inventor's
        ' message pump during startup.
    End Sub

    Protected Overrides Sub Dispose(disposing As Boolean)
        If disposing Then
            UninstallMouseHook()
        End If
        MyBase.Dispose(disposing)
    End Sub

    ''' <summary>
    ''' Installs the WH_MOUSE_LL hook if it is not already installed.
    ''' Called when the panel enters a mode that may need wheel scrolling.
    ''' </summary>
    Private Sub EnsureMouseHook()
        If _mouseHookId = IntPtr.Zero Then
            InstallMouseHook()
        End If
    End Sub

    ''' <summary>
    ''' Uninstalls the mouse hook when the panel returns to a mode
    ''' that does not need custom scrolling (e.g. Progress, idle-hidden).
    ''' </summary>
    Private Sub RemoveMouseHookIfIdle()
        UninstallMouseHook()
    End Sub

    Protected Overrides ReadOnly Property CreateParams As CreateParams
        Get
            Dim cp As CreateParams = MyBase.CreateParams
            ' NOTE: WS_EX_COMPOSITED (&H2000000) was removed because it
            ' caches the rendered back-buffer and causes ghost/overlay
            ' artifacts when the DockableWindow is resized.  DoubleBuffered
            ' + DoubleBufferedPanel provide sufficient flicker reduction.
            Return cp
        End Get
    End Property

    ' ==================================================================
    '  Public mode-switching methods
    ' ==================================================================

    ''' <summary>
    ''' Returns the panel to idle mode. Resets action state.
    ''' </summary>
    Public Sub ResetToIdle()
        _mode = PanelMode.Idle
        _action = UserAction.None
        _actionTaken = False
        ShowIdleContent()
        EnsureMouseHook()
    End Sub

    ''' <summary>
    ''' Switches the panel to parameter input mode pre-populated with
    ''' the given defaults.  Resets the action state so the caller can
    ''' poll <see cref="IsActionTaken"/> and read <see cref="ResultParameters"/>.
    ''' </summary>
    Public Sub EnterParameterInputMode(defaults As GratingParameters)
        _paramDefaults = defaults
        _resultParams = Nothing
        _action = UserAction.None
        _actionTaken = False
        _mode = PanelMode.ParameterInput
        ShowParameterInputContent()
        EnsureMouseHook()
    End Sub

    ''' <summary>
    ''' Switches the panel to boundary source mode. Shows project name,
    ''' sketch source radio buttons, and Continue/Cancel buttons.
    ''' The caller polls <see cref="IsActionTaken"/> then reads
    ''' <see cref="ResultProjectName"/> and <see cref="ResultSourceType"/>.
    ''' </summary>
    Public Sub EnterBoundarySourceMode(
            Optional defaultProjectName As String = "Grating",
            Optional namedSketchLookup As NamedSketchLookupResult = Nothing)
        _namedSketchLookup = namedSketchLookup
        _resultProjectName = If(defaultProjectName, "Grating")
        _resultSourceType = BoundarySourceType.SelectedSketch
        _action = UserAction.None
        _actionTaken = False
        _mode = PanelMode.BoundarySource
        ShowBoundarySourceContent()
        EnsureMouseHook()
    End Sub

    ''' <summary>
    ''' Switches the panel to progress mode showing the generation
    ''' progress bar.  Call <see cref="UpdateProgress"/> to advance.
    ''' </summary>
    Public Sub EnterProgressMode(Optional title As String = "Generating Grating...")
        _action = UserAction.None
        _actionTaken = False
        _mode = PanelMode.Progress
        ShowProgressContent(title)
        RemoveMouseHookIfIdle()
    End Sub

    ''' <summary>
    ''' Switches the panel to summary mode showing the generation
    ''' result summary text.
    ''' </summary>
    Public Sub EnterSummaryMode(summaryText As String)
        _action = UserAction.None
        _actionTaken = False
        _mode = PanelMode.Summary
        _lastSummaryText = summaryText
        ShowSummaryContent(summaryText)
        EnsureMouseHook()
    End Sub

    ''' <summary>
    ''' Sets the callback invoked when the user clicks the
    ''' "Create Drawing" button on the summary panel.
    ''' </summary>
    Public Sub SetCreateDrawingCallback(callback As Action)
        _createDrawingCallback = callback
    End Sub

    ''' <summary>
    ''' Updates the progress bar value, step text, and optional percentage.
    ''' Safe to call from the UI thread (inside a DoEvents loop).
    ''' </summary>
    Public Sub UpdateProgress(percent As Integer, stepText As String)
        If _mode <> PanelMode.Progress Then Return
        If _progressBar IsNot Nothing Then
            _progressBar.Value = Math.Min(Math.Max(percent, 0), 100)
        End If
        If _lblProgressStep IsNot Nothing Then
            _lblProgressStep.Text = stepText
        End If
    End Sub

    ' ==================================================================
    '  Layout construction
    ' ==================================================================

    Private Sub BuildLayout()
        Me.BackColor = _clrBack
        Me.ForeColor = _clrText
        Me.Dock = DockStyle.Fill
        Me.AutoScroll = False
        Me.Padding = New Padding(0)

        ' Content panel — NOT docked, NOT AutoScroll.
        ' Positioned and scrolled manually to avoid native scrollbar
        ' after-image artifacts inside Inventor DockableWindows.
        _contentPanel = New DoubleBufferedPanel()
        _contentPanel.Location = New Point(0, 0)
        _contentPanel.Size = New Size(Me.ClientSize.Width, Me.ClientSize.Height)
        _contentPanel.AutoScroll = False
        _contentPanel.Padding = New Padding(10, 10, 10, 10)
        _contentPanel.BackColor = _clrBack
        Me.Controls.Add(_contentPanel)

        ' Sticky button panel at bottom (outside scrollable content)
        _buttonPanel = New DoubleBufferedPanel()
        _buttonPanel.Height = ButtonPanelHeight
        _buttonPanel.Dock = DockStyle.Bottom
        _buttonPanel.BackColor = _clrBack
        _buttonPanel.Visible = False
        Me.Controls.Add(_buttonPanel)
        _buttonPanel.BringToFront()

        ' Custom scrollbar — thin track + draggable thumb.
        ' Native scrollbars leave after-image artifacts inside
        ' Inventor DockableWindows, so we draw our own.
        _scrollTrack = New DoubleBufferedPanel()
        _scrollTrack.Width = 14
        _scrollTrack.BackColor = Color.FromArgb(40, 43, 48)
        _scrollTrack.Visible = False
        Me.Controls.Add(_scrollTrack)
        _scrollTrack.BringToFront()

        _scrollThumb = New DoubleBufferedPanel()
        _scrollThumb.Width = 10
        _scrollThumb.Left = 2
        _scrollThumb.BackColor = Color.FromArgb(100, 103, 108)
        _scrollThumb.Cursor = Cursors.SizeNS
        _scrollTrack.Controls.Add(_scrollThumb)

        AddHandler _scrollThumb.MouseDown, AddressOf OnThumbMouseDown
        AddHandler _scrollThumb.MouseMove, AddressOf OnThumbMouseMove
        AddHandler _scrollThumb.MouseUp, AddressOf OnThumbMouseUp
        AddHandler _scrollTrack.MouseClick, AddressOf OnTrackMouseClick

        ' Sync width and clamp scroll when the DockableWindow is resized
        AddHandler Me.Resize, AddressOf OnContainerResize

        ' --- Idle mode controls ---
        _lblIdleTitle = New Label()
        _lblIdleTitle.Text = "Metal Bar Grating"
        _lblIdleTitle.Font = New Font(Me.Font.FontFamily, 10.0F, FontStyle.Bold)
        _lblIdleTitle.AutoSize = True
        _lblIdleTitle.ForeColor = _clrText
        _lblIdleTitle.Margin = New Padding(0, 0, 0, 8)

        _lblIdleInfo = New Label()
        _lblIdleInfo.Text =
            "Click ""Create Grating"" on the ribbon to begin." & vbCrLf & vbCrLf &
            "This panel will show workflow instructions " &
            "when a grating operation is in progress."
        _lblIdleInfo.AutoSize = False
        _lblIdleInfo.MaximumSize = New Size(600, 0)
        _lblIdleInfo.AutoSize = True
        _lblIdleInfo.ForeColor = _clrDimText

        ' Product info image — loaded from embedded resource
        _picIdleInfo = New PictureBox()
        _picIdleInfo.SizeMode = PictureBoxSizeMode.Zoom
        _picIdleInfo.BackColor = _clrBack
        _picIdleInfo.Margin = New Padding(0, 12, 0, 0)
        Try
            Dim asm As System.Reflection.Assembly = System.Reflection.Assembly.GetExecutingAssembly()
            Dim resName As String = Nothing
            For Each n As String In asm.GetManifestResourceNames()
                If n.EndsWith("BAR-GRATING-INFO-768x552.jpg", StringComparison.OrdinalIgnoreCase) Then
                    resName = n
                    Exit For
                End If
            Next
            If resName IsNot Nothing Then
                Using stream = asm.GetManifestResourceStream(resName)
                    _picIdleInfo.Image = New Bitmap(stream)
                End Using
            End If
        Catch
        End Try

        ' Company logo — loaded from embedded resource
        _picLogo = New PictureBox()
        _picLogo.SizeMode = PictureBoxSizeMode.Zoom
        _picLogo.BackColor = _clrBack
        Try
            Dim asmLogo As System.Reflection.Assembly = System.Reflection.Assembly.GetExecutingAssembly()
            Dim logoResName As String = Nothing
            For Each n As String In asmLogo.GetManifestResourceNames()
                If n.EndsWith("icons-grating-pacific_grating-pacific-logo.png", StringComparison.OrdinalIgnoreCase) Then
                    logoResName = n
                    Exit For
                End If
            Next
            If logoResName IsNot Nothing Then
                Using stream = asmLogo.GetManifestResourceStream(logoResName)
                    _picLogo.Image = New Bitmap(stream)
                End Using
            End If
        Catch
        End Try

        ' --- Progress mode controls ---
        _lblProgressTitle = New Label()
        _lblProgressTitle.Text = "Generating Grating..."
        _lblProgressTitle.Font = New Font(Me.Font.FontFamily, 10.0F, FontStyle.Bold)
        _lblProgressTitle.AutoSize = True
        _lblProgressTitle.ForeColor = _clrText

        _lblProgressStep = New Label()
        _lblProgressStep.Text = "Preparing..."
        _lblProgressStep.AutoSize = True
        _lblProgressStep.ForeColor = _clrDimText

        _progressBar = New ProgressBar()
        _progressBar.Minimum = 0
        _progressBar.Maximum = 100
        _progressBar.Value = 0
        _progressBar.Style = ProgressBarStyle.Continuous
        _progressBar.Size = New Size(200, 22)
    End Sub

    ' ==================================================================
    '  Content display helpers
    ' ==================================================================

    Private Sub ShowIdleContent()
        If _buttonPanel IsNot Nothing Then _buttonPanel.Visible = False
        _contentPanel.SuspendLayout()
        _contentPanel.Controls.Clear()

        Dim x As Integer = 24
        Dim y As Integer = 14
        Dim rightPad As Integer = 14
        Dim availW As Integer = EffectiveContentWidth - x - rightPad

        ' Title
        _lblIdleTitle.Location = New Point(x, y)
        _contentPanel.Controls.Add(_lblIdleTitle)
        y += _lblIdleTitle.PreferredHeight + 10

        ' Info text
        _lblIdleInfo.MaximumSize = New Size(availW, 0)
        _lblIdleInfo.Location = New Point(x, y)
        _contentPanel.Controls.Add(_lblIdleInfo)
        y += _lblIdleInfo.PreferredHeight + 18

        ' Product info image — padded on both sides, preserving aspect ratio
        If _picIdleInfo IsNot Nothing AndAlso _picIdleInfo.Image IsNot Nothing Then
            Dim img As Image = _picIdleInfo.Image
            Dim aspectRatio As Double = CDbl(img.Height) / CDbl(img.Width)
            Dim imgW As Integer = availW
            Dim imgH As Integer = CInt(imgW * aspectRatio)
            _picIdleInfo.Location = New Point(x, y)
            _picIdleInfo.Size = New Size(imgW, imgH)
            _contentPanel.Controls.Add(_picIdleInfo)
            y += imgH + 20
        End If

        ' --- Measure branding footer height ---
        Dim brandH As Integer = 0
        brandH += 1 + 14 ' separator + gap

        Dim logoH As Integer = 0
        If _picLogo IsNot Nothing AndAlso _picLogo.Image IsNot Nothing Then
            Dim logoImg As Image = _picLogo.Image
            Dim logoAspect As Double = CDbl(logoImg.Height) / CDbl(logoImg.Width)
            Dim logoW As Integer = Math.Min(availW, 220)
            logoH = CInt(logoW * logoAspect)
            brandH += logoH + 8
        Else
            brandH += 18 + 4 ' fallback text height
        End If

        Dim lblTagline As New Label()
        lblTagline.Text = "Service. Quality. Reliability."
        lblTagline.Font = New Font(Me.Font.FontFamily, 8.0F, FontStyle.Italic)
        lblTagline.AutoSize = True
        lblTagline.ForeColor = _clrDimText
        brandH += lblTagline.PreferredHeight + 8

        Dim lblUrl As New Label()
        lblUrl.Text = "gratingpacific.com"
        lblUrl.Font = New Font(Me.Font.FontFamily, 8.0F, FontStyle.Regular)
        lblUrl.AutoSize = True
        lblUrl.ForeColor = _clrAccent
        lblUrl.Cursor = Cursors.Hand
        AddHandler lblUrl.Click, Sub()
                                     Try
                                         System.Diagnostics.Process.Start("https://gratingpacific.com/")
                                     Catch
                                     End Try
                                 End Sub
        brandH += lblUrl.PreferredHeight + 6

        Dim lblCopyright As New Label()
        lblCopyright.Text = ChrW(&HA9) & " " & DateTime.Now.Year.ToString() & " Grating Pacific. All Rights Reserved."
        lblCopyright.Font = New Font(Me.Font.FontFamily, 7.5F, FontStyle.Regular)
        lblCopyright.AutoSize = True
        lblCopyright.ForeColor = Color.FromArgb(110, 110, 110)
        brandH += lblCopyright.PreferredHeight + 4

        ' Version label height
        brandH += 14 + 14  ' approximate version label height + bottom padding

        ' Push branding to bottom of visible area (or after content if it overflows)
        Dim visibleH As Integer = Me.ClientSize.Height
        Dim brandTop As Integer = Math.Max(y, visibleH - brandH)
        y = brandTop

        ' --- Branding footer ---
        Dim brandSep As New Label()
        brandSep.AutoSize = False
        brandSep.Height = 1
        brandSep.Width = availW
        brandSep.Location = New Point(x, y)
        brandSep.BackColor = _clrControlBorder
        _contentPanel.Controls.Add(brandSep)
        y += 14

        ' Company logo image
        If _picLogo IsNot Nothing Then
            Dim logoImg As Image = _picLogo.Image
            Dim logoAspect As Double = CDbl(logoImg.Height) / CDbl(logoImg.Width)
            Dim logoW As Integer = Math.Min(availW, 220)
            _picLogo.Location = New Point(x, y)
            _picLogo.Size = New Size(logoW, logoH)
            _contentPanel.Controls.Add(_picLogo)
            y += logoH + 8
        Else
            ' Fallback text if logo not available
            Dim lblCompany As New Label()
            lblCompany.Text = "GRATING PACIFIC"
            lblCompany.Font = New Font(Me.Font.FontFamily, 9.0F, FontStyle.Bold)
            lblCompany.AutoSize = True
            lblCompany.Location = New Point(x, y)
            lblCompany.ForeColor = _clrText
            _contentPanel.Controls.Add(lblCompany)
            y += lblCompany.PreferredHeight + 4
        End If

        lblTagline.Location = New Point(x, y)
        _contentPanel.Controls.Add(lblTagline)
        y += lblTagline.PreferredHeight + 8

        lblUrl.Location = New Point(x, y)
        _contentPanel.Controls.Add(lblUrl)
        y += lblUrl.PreferredHeight + 6

        lblCopyright.Location = New Point(x, y)
        _contentPanel.Controls.Add(lblCopyright)
        y += lblCopyright.PreferredHeight + 4

        Dim lblVersion As New Label()
        Dim asm As System.Reflection.Assembly = System.Reflection.Assembly.GetExecutingAssembly()
        Dim ver As Version = asm.GetName().Version
        lblVersion.Text = "v" & ver.Major & "." & ver.Minor & "." & ver.Build
        lblVersion.Font = New Font(Me.Font.FontFamily, 7.0F, FontStyle.Regular)
        lblVersion.AutoSize = True
        lblVersion.ForeColor = Color.FromArgb(90, 90, 90)
        lblVersion.Location = New Point(x, y)
        _contentPanel.Controls.Add(lblVersion)
        y += lblVersion.PreferredHeight + 14

        ' Enable scrolling if content exceeds visible area
        _contentHeight = y + 10
        _contentPanel.Width = Me.ClientSize.Width
        _contentPanel.Height = Math.Max(_contentHeight, Me.ClientSize.Height)
        _contentPanel.Top = 0
        _contentPanel.ResumeLayout(True)
        UpdateScrollbar()
    End Sub

    Private Sub ShowProgressContent(title As String)
        If _buttonPanel IsNot Nothing Then _buttonPanel.Visible = False
        _contentPanel.SuspendLayout()
        _contentPanel.Controls.Clear()

        Dim x As Integer = 24
        Dim y As Integer = 14
        Dim cw As Integer = EffectiveContentWidth - 38

        _lblProgressTitle.Text = title
        _lblProgressTitle.Location = New Point(x, y)
        _contentPanel.Controls.Add(_lblProgressTitle)
        y += 32

        _progressBar.Location = New Point(x, y)
        _progressBar.Size = New Size(cw, 22)
        _progressBar.Value = 0
        _contentPanel.Controls.Add(_progressBar)
        y += 34

        _lblProgressStep.Text = "Preparing..."
        _lblProgressStep.Location = New Point(x, y)
        _lblProgressStep.MaximumSize = New Size(Math.Max(100, cw), 0)
        _contentPanel.Controls.Add(_lblProgressStep)

        _contentPanel.ResumeLayout(True)

        ' No scrolling needed
        _contentHeight = Me.ClientSize.Height
        _contentPanel.Width = Me.ClientSize.Width
        _contentPanel.Height = _contentHeight
        _contentPanel.Top = 0
        UpdateScrollbar()
    End Sub

    Private Sub ShowSummaryContent(summaryText As String)
        _contentPanel.SuspendLayout()
        _contentPanel.Controls.Clear()

        Dim x As Integer = 24
        Dim y As Integer = 8
        Dim rightPad As Integer = 14
        Dim cw As Integer = EffectiveContentWidth - x - rightPad
        Dim anc As AnchorStyles = AnchorStyles.Left Or AnchorStyles.Top
        Dim valIndent As Integer = 16

        ' --- Sticky "Create Drawing" button in bottom panel ---
        If _createDrawingCallback IsNot Nothing Then
            _buttonPanel.Controls.Clear()
            _buttonPanel.Visible = True

            _btnCreateDrawing = New Button()
            _btnCreateDrawing.Text = "Create Drawing"
            _btnCreateDrawing.Font = New Font(Me.Font, FontStyle.Bold)
            Dim btnW As Integer = EffectiveContentWidth - x - rightPad
            _btnCreateDrawing.Size = New Size(btnW, 34)
            _btnCreateDrawing.Location = New Point(x, 6)
            _btnCreateDrawing.FlatStyle = FlatStyle.Flat
            _btnCreateDrawing.BackColor = _clrAccent
            _btnCreateDrawing.ForeColor = _clrText
            _btnCreateDrawing.FlatAppearance.BorderColor = _clrAccent
            _btnCreateDrawing.Cursor = Cursors.Hand
            AddHandler _btnCreateDrawing.Click, AddressOf OnCreateDrawingClick
            _buttonPanel.Controls.Add(_btnCreateDrawing)
        Else
            If _buttonPanel IsNot Nothing Then _buttonPanel.Visible = False
        End If

        ' --- Accent title ---
        _lblSummaryTitle = New Label()
        _lblSummaryTitle.Text = "GENERATION COMPLETE"
        _lblSummaryTitle.Font = New Font(Me.Font.FontFamily, 10.0F, FontStyle.Bold)
        _lblSummaryTitle.AutoSize = True
        _lblSummaryTitle.Location = New Point(x, y)
        _lblSummaryTitle.ForeColor = _clrAccent
        _contentPanel.Controls.Add(_lblSummaryTitle)
        y += _lblSummaryTitle.PreferredHeight + 6

        Dim titleSep As New Label()
        titleSep.AutoSize = False
        titleSep.Height = 2
        titleSep.Width = cw
        titleSep.Location = New Point(x, y)
        titleSep.BackColor = _clrAccent
        titleSep.Anchor = anc
        _contentPanel.Controls.Add(titleSep)
        y += 14

        ' Parse the summary text into labeled sections
        Dim lines() As String = summaryText.Split({vbCrLf, vbLf}, StringSplitOptions.None)

        For Each line As String In lines
            Dim trimmed As String = line.TrimEnd()

            ' Detect section headers (lines containing only ——— or ===)
            If trimmed.Length > 3 AndAlso
               (trimmed.Replace("—", "").Trim().Length = 0 OrElse
                trimmed.Replace("=", "").Trim().Length = 0) Then
                ' Skip — we already draw separators via AddSectionHeader
                Continue For
            End If

            ' Empty lines — add vertical spacing
            If String.IsNullOrWhiteSpace(trimmed) Then
                y += 10
                Continue For
            End If

            ' Section title lines (no colon, not indented, not a bullet)
            Dim isSectionTitle As Boolean =
                Not trimmed.StartsWith(" ") AndAlso
                Not trimmed.StartsWith("•") AndAlso
                Not trimmed.Contains(":")

            ' Key-value lines (contains " : ")
            Dim colonPos As Integer = trimmed.IndexOf(" : ")
            If colonPos < 0 Then colonPos = trimmed.IndexOf(": ")

            If isSectionTitle Then
                ' Section heading with chevron and separator
                AddSectionHeader(_contentPanel, trimmed, x, y, cw)
            ElseIf colonPos > 0 Then
                ' Key : Value pair — key dim above, value bright below
                Dim key As String = trimmed.Substring(0, colonPos).Trim()
                Dim val As String = trimmed.Substring(colonPos + 1).Trim().TrimStart(":"c).Trim()

                Dim keyLbl As New Label()
                keyLbl.Text = key
                keyLbl.Font = New Font(Me.Font, FontStyle.Regular)
                keyLbl.AutoSize = True
                keyLbl.Location = New Point(x, y)
                keyLbl.ForeColor = _clrDimText
                _contentPanel.Controls.Add(keyLbl)
                y += keyLbl.PreferredHeight + 2

                Dim valLbl As New Label()
                valLbl.Text = val
                valLbl.AutoSize = False
                valLbl.MaximumSize = New Size(Math.Max(60, cw - valIndent), 0)
                valLbl.AutoSize = True
                valLbl.Location = New Point(x + valIndent, y)
                valLbl.ForeColor = _clrText
                _contentPanel.Controls.Add(valLbl)
                y += valLbl.PreferredHeight + 8
            Else
                ' Regular text (bullets, warnings, file names)
                Dim txtLbl As New Label()
                txtLbl.Text = trimmed
                txtLbl.AutoSize = False
                txtLbl.MaximumSize = New Size(Math.Max(60, cw), 0)
                txtLbl.AutoSize = True
                txtLbl.Location = New Point(x, y)
                txtLbl.ForeColor = If(trimmed.StartsWith("•") OrElse
                                      trimmed.TrimStart().StartsWith("•"),
                                      _clrDimText, _clrText)
                _contentPanel.Controls.Add(txtLbl)
                y += txtLbl.PreferredHeight + 6
            End If
        Next

        ' Set content height for manual scrolling
        Dim scrollAreaH As Integer = Me.ClientSize.Height
        If _buttonPanel IsNot Nothing AndAlso _buttonPanel.Visible Then scrollAreaH -= ButtonPanelHeight
        _contentHeight = y + 10
        _contentPanel.Width = Me.ClientSize.Width
        _contentPanel.Height = Math.Max(_contentHeight, scrollAreaH)
        _contentPanel.Top = 0
        _contentPanel.ResumeLayout(True)
        UpdateScrollbar()
    End Sub

    Private Sub OnCreateDrawingClick()
        If _createDrawingCallback Is Nothing Then Return
        ' Disable button to prevent double-click
        If _btnCreateDrawing IsNot Nothing Then
            _btnCreateDrawing.Enabled = False
            _btnCreateDrawing.Text = "Creating Drawing..."
            _btnCreateDrawing.BackColor = _clrControlBack
            _btnCreateDrawing.FlatAppearance.BorderColor = _clrControlBorder
        End If
        Try
            _createDrawingCallback.Invoke()
        Catch ex As Exception
            MessageBox.Show(
                "Drawing generation failed:" & vbCrLf & ex.Message,
                "Metal Bar Grating — Drawing Error",
                MessageBoxButtons.OK, MessageBoxIcon.Warning)
        End Try
        ' Update button to show completion
        If _btnCreateDrawing IsNot Nothing Then
            _btnCreateDrawing.Text = "Drawing Created"
        End If
    End Sub

