    Private Sub AddFieldLabel(parent As Control, text As String, x As Integer, y As Integer)
        Dim lbl As New Label()
        lbl.Text = text
        lbl.AutoSize = True
        lbl.Location = New Point(x, y)
        lbl.ForeColor = _clrText
        parent.Controls.Add(lbl)
    End Sub

    ''' <summary>
    ''' Same as AddFieldLabel but returns the Label so the caller can
    ''' store it for later enable/disable toggling.
    ''' </summary>
    Private Function AddFieldLabelEx(parent As Control, text As String, x As Integer, y As Integer) As Label
        Dim lbl As New Label()
        lbl.Text = text
        lbl.AutoSize = True
        lbl.Location = New Point(x, y)
        lbl.ForeColor = _clrText
        parent.Controls.Add(lbl)
        Return lbl
    End Function

    Private Sub AddBoldLabel(parent As Control, text As String, x As Integer, y As Integer,
                             Optional fontSize As Single = 0)
        Dim lbl As New Label()
        lbl.Text = text
        lbl.AutoSize = True
        lbl.Location = New Point(x, y)
        lbl.ForeColor = _clrText
        If fontSize > 0 Then
            lbl.Font = New Font(Me.Font.FontFamily, fontSize, FontStyle.Bold)
        Else
            lbl.Font = New Font(Me.Font, FontStyle.Bold)
        End If
        parent.Controls.Add(lbl)
    End Sub

    ''' <summary>
    ''' Adds a section header with a separator line and ▼ chevron label.
    ''' Advances y by reference.
    ''' </summary>
    Private Sub AddSectionHeader(parent As Control, text As String, x As Integer,
                                   ByRef y As Integer, cw As Integer)
        Dim sep As New Label()
        sep.AutoSize = False
        sep.Height = 1
        sep.Width = cw
        sep.Location = New Point(x, y)
        sep.BackColor = _clrControlBorder
        parent.Controls.Add(sep)
        y += 12

        Dim lbl As New Label()
        lbl.Text = ChrW(&H25BC) & "  " & text
        lbl.Font = New Font(Me.Font, FontStyle.Bold)
        lbl.AutoSize = True
        lbl.Location = New Point(x, y)
        lbl.ForeColor = _clrText
        parent.Controls.Add(lbl)
        y += 28
    End Sub

    ''' <summary>
    ''' Adds a collapsible section header with chevron, optional badge,
    ''' and click handler. Advances y by reference.
    ''' </summary>
    Private Sub AddCollapsibleSectionHeader(parent As Control, text As String,
                                             badge As String, x As Integer,
                                             ByRef y As Integer, cw As Integer,
                                             clickHandler As EventHandler)
        Dim sep As New Label()
        sep.AutoSize = False
        sep.Height = 1
        sep.Width = cw
        sep.Location = New Point(x, y)
        sep.BackColor = _clrControlBorder
        parent.Controls.Add(sep)
        y += 12

        Dim chevron As String = If(_notchSectionCollapsed, ChrW(&H25B6), ChrW(&H25BC))
        Dim lbl As New Label()
        lbl.Text = chevron & "  " & text
        lbl.Font = New Font(Me.Font, FontStyle.Bold)
        lbl.AutoSize = True
        lbl.Location = New Point(x, y)
        lbl.ForeColor = _clrAccent
        lbl.Cursor = Cursors.Hand
        AddHandler lbl.Click, clickHandler
        parent.Controls.Add(lbl)

        If Not String.IsNullOrEmpty(badge) Then
            Dim badgeLbl As New Label()
            badgeLbl.Text = badge
            badgeLbl.Font = New Font(Me.Font.FontFamily, 7.0F, FontStyle.Italic)
            badgeLbl.AutoSize = True
            badgeLbl.Location = New Point(x + lbl.PreferredWidth + 8, y + 3)
            badgeLbl.ForeColor = _clrDimText
            parent.Controls.Add(badgeLbl)
        End If
        y += 28
    End Sub

    ''' <summary>
    ''' Toggles the notch section collapsed state, saves current
    ''' parameter values, and rebuilds the panel.
    ''' </summary>
    Private Sub OnNotchSectionToggle(sender As Object, e As EventArgs)
        _notchSectionCollapsed = Not _notchSectionCollapsed
        Dim saved = ParseCurrentParameters()
        _paramDefaults = saved
        ShowParameterInputContent()
    End Sub

