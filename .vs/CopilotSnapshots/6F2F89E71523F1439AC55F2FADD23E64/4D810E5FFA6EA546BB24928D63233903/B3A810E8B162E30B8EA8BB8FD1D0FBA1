    ''' <summary>
    ''' Tracks the last client width so we can detect when the
    ''' DockableWindow has been resized horizontally and re-layout.
    ''' </summary>
    Private _lastClientWidth As Integer = 0

    Private Sub OnContainerResize(sender As Object, e As EventArgs)
        If _contentPanel Is Nothing Then Return
        If _isResizing Then Return
        _isResizing = True
        Try
            Dim curWidth As Integer = Me.ClientSize.Width

            ' If the width changed, re-layout the current mode so
            ' controls reflow to fit the new available width.
            If curWidth <> _lastClientWidth AndAlso curWidth > 0 Then
                _lastClientWidth = curWidth
                RelayoutCurrentMode()
                Return  ' RelayoutCurrentMode already handles height/scroll
            End If

            ' Height-only change — adjust scroll position.
            _contentPanel.SuspendLayout()
            _contentPanel.Width = curWidth
            Dim visH = Me.ClientSize.Height
            If _buttonPanel IsNot Nothing AndAlso _buttonPanel.Visible Then visH -= ButtonPanelHeight
            _contentPanel.Height = Math.Max(_contentHeight, visH)
            Dim maxScroll = Math.Max(0, _contentHeight - visH)
            Dim offset = Math.Max(0, -_contentPanel.Top)
            offset = Math.Min(maxScroll, offset)
            _contentPanel.Top = -offset
            _contentPanel.ResumeLayout(True)
            UpdateScrollbar()
        Finally
            _isResizing = False
        End Try
    End Sub

    ''' <summary>
    ''' Re-renders the current panel mode so controls reflow to the
    ''' new <see cref="EffectiveContentWidth"/>.
    ''' </summary>
    Private Sub RelayoutCurrentMode()
        Select Case _mode
            Case PanelMode.Idle
                ShowIdleContent()
            Case PanelMode.BoundarySource
                ShowBoundarySourceContent()
            Case PanelMode.ParameterInput
                ' Preserve current field values before rebuild
                If _paramDefaults Is Nothing Then _paramDefaults = New GratingParameters()
                _paramDefaults = ParseCurrentParameters()
                ShowParameterInputContent()
            Case PanelMode.Progress
                Dim stepText As String = ""
                Dim pctVal As Integer = 0
                If _lblProgressStep IsNot Nothing Then stepText = _lblProgressStep.Text
                If _progressBar IsNot Nothing Then pctVal = _progressBar.Value
                ShowProgressContent(If(_lblProgressTitle?.Text, "Generating Grating..."))
                UpdateProgress(pctVal, stepText)
            Case PanelMode.Summary
                If _lastSummaryText IsNot Nothing Then
                    ShowSummaryContent(_lastSummaryText)
                End If
        End Select
    End Sub

    Friend Sub ScrollContent(delta As Integer)
        If _contentPanel Is Nothing Then Return
        Dim visH = Me.ClientSize.Height
        If _buttonPanel IsNot Nothing AndAlso _buttonPanel.Visible Then visH -= ButtonPanelHeight
        Dim maxScroll = Math.Max(0, _contentHeight - visH)
        If maxScroll = 0 Then Return
        Dim offset = Math.Max(0, -_contentPanel.Top)
        offset -= delta
        offset = Math.Min(maxScroll, Math.Max(0, offset))
        _contentPanel.Top = -offset
        UpdateScrollbar()
    End Sub

    ' ==================================================================
    '  Custom scrollbar
    ' ==================================================================

    ''' <summary>
    ''' Syncs the scrollbar track/thumb visibility and position with
    ''' the current content height and scroll offset.
    ''' </summary>
    Private Sub UpdateScrollbar()
        If _scrollTrack Is Nothing Then Return

        Dim visH As Integer = Me.ClientSize.Height
        If _buttonPanel IsNot Nothing AndAlso _buttonPanel.Visible Then visH -= ButtonPanelHeight
        Dim maxScroll As Integer = Math.Max(0, _contentHeight - visH)

        If maxScroll <= 0 Then
            _scrollTrack.Visible = False
            Return
        End If

        _scrollTrack.Visible = True
        _scrollTrack.Location = New Point(Me.ClientSize.Width - 14, 0)
        _scrollTrack.Size = New Size(14, visH)

        ' Thumb height proportional to visible / total (min 30 px)
        Dim thumbH As Integer = Math.Max(30,
            CInt(CDbl(visH) * visH / _contentHeight))
        _scrollThumb.Size = New Size(10, thumbH)
        _scrollThumb.Left = 2

        ' Thumb position from current scroll offset
        Dim offset As Integer = Math.Max(0, -_contentPanel.Top)
        Dim trackRange As Integer = visH - thumbH
        If trackRange > 0 AndAlso maxScroll > 0 Then
            _scrollThumb.Top = CInt(CDbl(offset) / maxScroll * trackRange)
        Else
            _scrollThumb.Top = 0
        End If
    End Sub

    Private Sub OnThumbMouseDown(sender As Object, e As MouseEventArgs)
        _isDraggingThumb = True
        _thumbDragStartY = e.Y
        _thumbDragStartTop = _scrollThumb.Top
        _scrollThumb.BackColor = Color.FromArgb(140, 143, 148)
    End Sub

    Private Sub OnThumbMouseMove(sender As Object, e As MouseEventArgs)
        If Not _isDraggingThumb Then Return

        Dim visH As Integer = Me.ClientSize.Height
        If _buttonPanel IsNot Nothing AndAlso _buttonPanel.Visible Then visH -= ButtonPanelHeight
        Dim thumbH As Integer = _scrollThumb.Height
        Dim trackRange As Integer = visH - thumbH
        If trackRange <= 0 Then Return

        Dim newTop As Integer = _thumbDragStartTop + (e.Y - _thumbDragStartY)
        newTop = Math.Max(0, Math.Min(trackRange, newTop))
        _scrollThumb.Top = newTop

        ' Convert thumb position to content scroll offset
        Dim maxScroll As Integer = Math.Max(0, _contentHeight - visH)
        Dim offset As Integer = CInt(CDbl(newTop) / trackRange * maxScroll)
        _contentPanel.Top = -offset
    End Sub

    Private Sub OnThumbMouseUp(sender As Object, e As MouseEventArgs)
        _isDraggingThumb = False
        _scrollThumb.BackColor = Color.FromArgb(100, 103, 108)
    End Sub

    Private Sub OnTrackMouseClick(sender As Object, e As MouseEventArgs)
        ' Page-scroll toward the clicked position
        Dim visH As Integer = Me.ClientSize.Height
        If e.Y < _scrollThumb.Top Then
            ScrollContent(visH \ 2)
        ElseIf e.Y > _scrollThumb.Top + _scrollThumb.Height Then
            ScrollContent(-(visH \ 2))
        End If
    End Sub

