'////////////////////////////////////////////////////////////////////
' Metal Bar Grating Addin - VB.NET
'
' HmgPanelControl: UserControl hosted inside an Inventor DockableWindow.
' Provides a native docked panel experience similar to iLogic or
' Design Accelerator panels.
'
' The panel supports multiple display modes:
'   Idle          — default state showing add-in info
'   ParameterInput— grating parameter controls
'   Progress      — generation progress bar
'   Summary       — generation results
'
' The panel uses vertical stacking layout (DockStyle.Top) so it
' resizes properly when the dockable window is resized by the user.
'
' Signaling: when the user clicks OK or Cancel during ParameterInput
' mode, the IsActionTaken flag is set.  The caller polls this flag
' via a DoEvents loop.
'////////////////////////////////////////////////////////////////////

Imports System.Drawing
Imports System.Runtime.InteropServices
Imports System.Windows.Forms

''' <summary>
''' UserControl that lives inside an Inventor DockableWindow.
''' Shows context-sensitive content for the HMG workflow.
''' </summary>
Public Class HmgPanelControl
    Inherits UserControl

    ' ==================================================================
    '  Panel modes and actions
    ' ==================================================================

    ''' <summary>Display mode of the panel.</summary>
    Public Enum PanelMode
        ''' <summary>Default idle state — shows add-in info.</summary>
        Idle = 0
        ''' <summary>Boundary source selection — project name + sketch source.</summary>
        BoundarySource = 1
        ''' <summary>Parameter input — shows grating parameter controls.</summary>
        ParameterInput = 2
        ''' <summary>Progress — shows generation progress bar.</summary>
        Progress = 3
        ''' <summary>Summary — shows generation results.</summary>
        Summary = 4
    End Enum

    ''' <summary>Action taken by the user in SketchEdit mode.</summary>
    Public Enum UserAction
        ''' <summary>No action yet.</summary>
        None = 0
        ''' <summary>User clicked Done — finished drawing.</summary>
        Done = 1
        ''' <summary>User clicked Cancel.</summary>
        Cancel = 2
    End Enum

    ' ==================================================================
    '  State
    ' ==================================================================

    Private _mode As PanelMode = PanelMode.Idle
    Private _action As UserAction = UserAction.None
    Private _actionTaken As Boolean = False
    Private _paramDefaults As GratingParameters
    Private _resultParams As GratingParameters

    ' Boundary source mode state
    Private _namedSketchLookup As NamedSketchLookupResult
    Private _resultProjectName As String
    Private _resultSourceType As BoundarySourceType

    ' Re-entrancy guard for OnContainerResize
    Private _isResizing As Boolean = False

    ' Summary mode — stored raw text for re-layout and button callback
    Private _lastSummaryText As String = Nothing
    Private _createDrawingCallback As Action = Nothing
    Private _btnCreateDrawing As Button

    ' ==================================================================
    '  Dark theme colors (match Inventor 2024 dark browser background)
    ' ==================================================================
    Private Shared ReadOnly _clrBack As Color = Color.FromArgb(50, 53, 58)
    Private Shared ReadOnly _clrText As Color = Color.FromArgb(241, 241, 241)
    Private Shared ReadOnly _clrDimText As Color = Color.FromArgb(160, 160, 160)
    Private Shared ReadOnly _clrAccent As Color = Color.FromArgb(0, 122, 204)
    Private Shared ReadOnly _clrControlBack As Color = Color.FromArgb(60, 63, 68)
    Private Shared ReadOnly _clrControlBorder As Color = Color.FromArgb(72, 75, 80)
    Private Shared ReadOnly _clrToggleActive As Color = Color.FromArgb(0, 122, 204)
    Private Shared ReadOnly _clrToggleInactive As Color = Color.FromArgb(60, 63, 68)
    Private Shared ReadOnly _clrDisabledText As Color = Color.FromArgb(100, 100, 100)
    Private Shared ReadOnly _clrDisabledBack As Color = Color.FromArgb(45, 48, 52)

    ' ==================================================================
    '  Controls
    ' ==================================================================

    ' Content panel — manually positioned and scrolled.
    ' Native scrollbars are avoided because they leave after-image
    ' artifacts inside Inventor DockableWindows.
    Private _contentPanel As Panel
    Private _contentHeight As Integer = 0

    ' Maximum layout width — caps the content area so it never
    ' exceeds the actual dockable window width.
    Private Const MaxContentWidth As Integer = 600

    ''' <summary>
    ''' Effective content width capped to the actual client width
    ''' so controls never overflow the visible panel area.
    ''' </summary>
    Private ReadOnly Property EffectiveContentWidth As Integer
        Get
            Dim w As Integer = Me.ClientSize.Width
            If w <= 0 Then Return MaxContentWidth
            Return Math.Min(MaxContentWidth, w)
        End Get
    End Property

    ' Idle mode controls
    Private _lblIdleTitle As Label
    Private _lblIdleInfo As Label
    Private _picIdleInfo As PictureBox
    Private _picLogo As PictureBox

    ' Boundary source mode controls
    Private _txtBsProjectName As TextBox
    Private _rbBsSelectedSketch As RadioButton
    Private _rbBsNamedSketch As RadioButton
    Private _btnBsContinue As Button
    Private _btnBsCancel As Button

    ' Parameter input mode controls
    Private _cboSpanDirection As ComboBox
    Private _txtBarDepth As TextBox
    Private _txtBarWidth As TextBox
    Private _cboOnCenterSpacing As ComboBox
    Private _cboCrossBarType As ComboBox
    Private _cboCrossBarOC As ComboBox
    Private _txtFirstCrossBarOffset As TextBox
    Private _btnPlain As Button
    Private _btnSerrated As Button
    Private _btnBanded As Button
    Private _btnOpenEnded As Button
    Private _txtOutputFolder As TextBox
    Private _btnBrowseFolder As Button
    Private _txtNamingPrefix As TextBox
    Private _btnParamOK As Button
    Private _btnParamCancel As Button

