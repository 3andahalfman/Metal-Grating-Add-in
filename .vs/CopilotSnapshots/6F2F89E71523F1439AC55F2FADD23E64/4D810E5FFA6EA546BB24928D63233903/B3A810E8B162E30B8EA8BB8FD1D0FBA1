    ''' <summary>
    ''' Builds a GratingParameters object from the current panel fields.
    ''' Best-effort parsing (no validation errors) for re-population.
    ''' </summary>
    Friend Function ParseCurrentParameters() As GratingParameters
        Dim result As New GratingParameters()

        result.SpanDirection = If(_cboSpanDirection IsNot Nothing AndAlso
            _cboSpanDirection.SelectedIndex = 1,
            SpanDirectionType.AlongY, SpanDirectionType.AlongX)

        Dim barDepth As Double
        If _txtBarDepth IsNot Nothing AndAlso
           Double.TryParse(_txtBarDepth.Text.Trim(), barDepth) Then
            result.BarDepth = barDepth
        Else
            result.BarDepth = 2.0

        End If

        Dim barWidth As Double
        If _txtBarWidth IsNot Nothing AndAlso
           Double.TryParse(_txtBarWidth.Text.Trim(), barWidth) Then
            result.BarWidth = barWidth
        Else
            result.BarWidth = 0.1875
        End If

        Dim spacing As Double
        If _cboOnCenterSpacing IsNot Nothing AndAlso
           _cboOnCenterSpacing.SelectedIndex >= 0 AndAlso
           _cboOnCenterSpacing.SelectedIndex < _ocSpacingValues.Length Then
            result.OnCenterSpacing = _ocSpacingValues(_cboOnCenterSpacing.SelectedIndex)
        Else
            result.OnCenterSpacing = 1.1875
        End If

        If _cboCrossBarType IsNot Nothing AndAlso _cboCrossBarType.SelectedIndex >= 0 Then
            result.CrossBar = CType(_cboCrossBarType.SelectedIndex, CrossBarType)
        End If

        If _cboCrossBarOC IsNot Nothing AndAlso _cboCrossBarOC.SelectedItem IsNot Nothing Then
            Dim ocValue As Double
            If Double.TryParse(CStr(_cboCrossBarOC.SelectedItem), ocValue) Then
                result.CrossBarOnCenter = ocValue
            Else
                result.CrossBarOnCenter = 2.0
            End If
        End If

        Dim firstOffset As Double
        If _txtFirstCrossBarOffset IsNot Nothing AndAlso
           Double.TryParse(_txtFirstCrossBarOffset.Text.Trim(), firstOffset) Then
            result.FirstCrossBarOffset = firstOffset
        Else
            result.FirstCrossBarOffset = 1.0
        End If

        result.SurfaceProfile = If(_isSerrationActive, SurfaceProfileType.Serrated, SurfaceProfileType.Plain)

        result.Banding = If(_isBandingOpen, BandingOptionType.OpenEnded, BandingOptionType.Banded)

        If _txtOutputFolder IsNot Nothing Then
            result.OutputFolder = _txtOutputFolder.Text.Trim()
        End If

        If _txtNamingPrefix IsNot Nothing Then
            result.NamingPrefix = _txtNamingPrefix.Text.Trim()
        End If

        ' Notch overrides — best-effort parse
        Dim nv As Double
        If _txtNotchSlotWidth IsNot Nothing AndAlso
           Not String.IsNullOrWhiteSpace(_txtNotchSlotWidth.Text) AndAlso
           Double.TryParse(_txtNotchSlotWidth.Text.Trim(), nv) AndAlso nv > 0 Then
            result.NotchSlotWidthOverride = nv
        End If
        If _txtNotchSlotDepth IsNot Nothing AndAlso
           Not String.IsNullOrWhiteSpace(_txtNotchSlotDepth.Text) AndAlso
           Double.TryParse(_txtNotchSlotDepth.Text.Trim(), nv) AndAlso nv > 0 Then
            result.NotchSlotDepthOverride = nv
        End If
        If _txtNotchStraightDepth IsNot Nothing AndAlso
           Not String.IsNullOrWhiteSpace(_txtNotchStraightDepth.Text) AndAlso
           Double.TryParse(_txtNotchStraightDepth.Text.Trim(), nv) AndAlso nv >= 0 Then
            result.NotchStraightDepthOverride = nv
        End If
        If _txtNotchBottomRadius IsNot Nothing AndAlso
           Not String.IsNullOrWhiteSpace(_txtNotchBottomRadius.Text) AndAlso
           Double.TryParse(_txtNotchBottomRadius.Text.Trim(), nv) AndAlso nv >= 0 Then
            result.NotchBottomRadiusOverride = nv
        End If

        ' Serration overrides — best-effort parse (only when serrated toggle is active)
        If _isSerrationActive Then
            If _txtSerrChord IsNot Nothing AndAlso
               Not String.IsNullOrWhiteSpace(_txtSerrChord.Text) AndAlso
               Double.TryParse(_txtSerrChord.Text.Trim(), nv) AndAlso nv > 0 Then
                result.SerrationChordOverride = nv
            End If
            If _txtSerrFlatWidth IsNot Nothing AndAlso
               Not String.IsNullOrWhiteSpace(_txtSerrFlatWidth.Text) AndAlso
               Double.TryParse(_txtSerrFlatWidth.Text.Trim(), nv) AndAlso nv >= 0 Then
                result.SerrationFlatWidthOverride = nv
            End If
            If _txtSerrArcRadius IsNot Nothing AndAlso
               Not String.IsNullOrWhiteSpace(_txtSerrArcRadius.Text) AndAlso
               Double.TryParse(_txtSerrArcRadius.Text.Trim(), nv) AndAlso nv > 0 Then
                result.SerrationArcRadiusOverride = nv
            End If
            If _txtSerrMargin IsNot Nothing AndAlso
               Not String.IsNullOrWhiteSpace(_txtSerrMargin.Text) AndAlso
               Double.TryParse(_txtSerrMargin.Text.Trim(), nv) AndAlso nv >= 0 Then
                result.SerrationMarginOverride = nv
            End If
        End If

        Return result
    End Function

