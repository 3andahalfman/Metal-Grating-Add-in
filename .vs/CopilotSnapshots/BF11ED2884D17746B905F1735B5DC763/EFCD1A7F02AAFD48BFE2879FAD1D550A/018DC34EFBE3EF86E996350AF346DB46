'////////////////////////////////////////////////////////////////////
' Hand Made Grating Addin - VB.NET
'
' HmgPanelControl: UserControl hosted inside an Inventor DockableWindow.
' Provides a native docked panel experience similar to iLogic or
' Design Accelerator panels.
'
' The panel supports multiple display modes:
'   Idle        — default state showing add-in info
'   SketchEdit  — sketch editing instructions with Done/Cancel buttons
'
' The panel uses vertical stacking layout (DockStyle.Top) so it
' resizes properly when the dockable window is resized by the user.
'
' Signaling: when the user clicks Done or Cancel during SketchEdit
' mode, the IsActionTaken flag is set.  The caller polls this flag
' via a DoEvents loop (same pattern as NoBoundarySketchForm).
'////////////////////////////////////////////////////////////////////

Imports System.Drawing
Imports System.Windows.Forms

''' <summary>
''' UserControl that lives inside an Inventor DockableWindow.
''' Shows context-sensitive content for the HMG workflow.
''' </summary>
Public Class HmgPanelControl
    Inherits UserControl

    ' ==================================================================
    '  Panel modes and actions
    ' ==================================================================

    ''' <summary>Display mode of the panel.</summary>
    Public Enum PanelMode
        ''' <summary>Default idle state — shows add-in info.</summary>
        Idle = 0
        ''' <summary>Sketch editing — shows drawing instructions.</summary>
        SketchEdit = 1
        ''' <summary>Parameter input — shows grating parameter controls.</summary>
        ParameterInput = 2
    End Enum

    ''' <summary>Action taken by the user in SketchEdit mode.</summary>
    Public Enum UserAction
        ''' <summary>No action yet.</summary>
        None = 0
        ''' <summary>User clicked Done — finished drawing.</summary>
        Done = 1
        ''' <summary>User clicked Cancel.</summary>
        Cancel = 2
    End Enum

    ' ==================================================================
    '  State
    ' ==================================================================

    Private _mode As PanelMode = PanelMode.Idle
    Private _action As UserAction = UserAction.None
    Private _actionTaken As Boolean = False
    Private _sketchName As String = ""
    Private _paramDefaults As GratingParameters
    Private _resultParams As GratingParameters

    ' ==================================================================
    '  Controls
    ' ==================================================================

    ' Content panel that holds all dynamic content
    Private _contentPanel As Panel

    ' Idle mode controls
    Private _lblIdleTitle As Label
    Private _lblIdleInfo As Label

    ' Sketch edit mode controls
    Private _lblEditTitle As Label
    Private _lblEditSketchName As Label
    Private _lblEditInstructions As Label
    Private _btnDone As Button
    Private _btnCancel As Button

    ' Parameter input mode controls
    Private _cboSpanDirection As ComboBox
    Private _txtBarDepth As TextBox
    Private _txtBarWidth As TextBox
    Private _txtOnCenterSpacing As TextBox
    Private _cboCrossBarType As ComboBox
    Private _cboCrossBarOC As ComboBox
    Private _txtFirstCrossBarOffset As TextBox
    Private _cboSurfaceProfile As ComboBox
    Private _cboBanding As ComboBox
    Private _txtOutputFolder As TextBox
    Private _btnBrowseFolder As Button
    Private _txtNamingPrefix As TextBox
    Private _btnParamOK As Button
    Private _btnParamCancel As Button

    ' ==================================================================
    '  Public properties
    ' ==================================================================

    ''' <summary>The last action taken by the user.</summary>
    Public ReadOnly Property LastAction As UserAction
        Get
            Return _action
        End Get
    End Property

    ''' <summary>True once the user clicks Done or Cancel.</summary>
    Public ReadOnly Property IsActionTaken As Boolean
        Get
            Return _actionTaken
        End Get
    End Property

    ''' <summary>Current display mode.</summary>
    Public ReadOnly Property Mode As PanelMode
        Get
            Return _mode
        End Get
    End Property

    ''' <summary>Validated parameters from the last ParameterInput accept.</summary>
    Public ReadOnly Property ResultParameters As GratingParameters
        Get
            Return _resultParams
        End Get
    End Property

    ' ==================================================================
    '  Constructor
    ' ==================================================================

    Public Sub New()
        BuildLayout()
        ShowIdleContent()
    End Sub

    ' ==================================================================
    '  Public mode-switching methods
    ' ==================================================================

    ''' <summary>
    ''' Switches the panel to sketch edit mode with instructions for
    ''' the given sketch name. Resets the action state so the caller
    ''' can poll <see cref="IsActionTaken"/>.
    ''' </summary>
    Public Sub EnterSketchEditMode(sketchName As String)
        _sketchName = sketchName
        _action = UserAction.None
        _actionTaken = False
        _mode = PanelMode.SketchEdit
        ShowSketchEditContent()
    End Sub

    ''' <summary>
    ''' Returns the panel to idle mode. Resets action state.
    ''' </summary>
    Public Sub ResetToIdle()
        _mode = PanelMode.Idle
        _action = UserAction.None
        _actionTaken = False
        ShowIdleContent()
    End Sub

    ''' <summary>
    ''' Switches the panel to parameter input mode pre-populated with
    ''' the given defaults.  Resets the action state so the caller can
    ''' poll <see cref="IsActionTaken"/> and read <see cref="ResultParameters"/>.
    ''' </summary>
    Public Sub EnterParameterInputMode(defaults As GratingParameters)
        _paramDefaults = defaults
        _resultParams = Nothing
        _action = UserAction.None
        _actionTaken = False
        _mode = PanelMode.ParameterInput
        ShowParameterInputContent()
    End Sub

    ' ==================================================================
    '  Layout construction
    ' ==================================================================

    Private Sub BuildLayout()
        Me.BackColor = SystemColors.Control
        Me.Dock = DockStyle.Fill
        Me.AutoScroll = True
        Me.Padding = New Padding(0)

        ' Main content panel fills the entire control
        _contentPanel = New Panel()
        _contentPanel.Dock = DockStyle.Fill
        _contentPanel.AutoScroll = True
        _contentPanel.Padding = New Padding(10, 10, 10, 10)
        Me.Controls.Add(_contentPanel)

        ' --- Idle mode controls ---
        _lblIdleTitle = New Label()
        _lblIdleTitle.Text = "Hand Made Grating"
        _lblIdleTitle.Font = New Font(Me.Font.FontFamily, 10.0F, FontStyle.Bold)
        _lblIdleTitle.AutoSize = True
        _lblIdleTitle.Margin = New Padding(0, 0, 0, 8)

        _lblIdleInfo = New Label()
        _lblIdleInfo.Text =
            "Click ""Create Grating"" on the ribbon to begin." & vbCrLf & vbCrLf &
            "This panel will show workflow instructions " &
            "when a grating operation is in progress."
        _lblIdleInfo.AutoSize = False
        _lblIdleInfo.MaximumSize = New Size(280, 0)
        _lblIdleInfo.AutoSize = True
        _lblIdleInfo.ForeColor = SystemColors.GrayText

        ' --- Sketch edit mode controls ---
        _lblEditTitle = New Label()
        _lblEditTitle.Text = "Draw Boundary Perimeter"
        _lblEditTitle.Font = New Font(Me.Font.FontFamily, 10.0F, FontStyle.Bold)
        _lblEditTitle.AutoSize = True
        _lblEditTitle.Margin = New Padding(0, 0, 0, 6)

        _lblEditSketchName = New Label()
        _lblEditSketchName.Text = ""
        _lblEditSketchName.AutoSize = True
        _lblEditSketchName.ForeColor = Color.FromArgb(0, 102, 204)
        _lblEditSketchName.Margin = New Padding(0, 0, 0, 10)

        _lblEditInstructions = New Label()
        _lblEditInstructions.Text = ""
        _lblEditInstructions.AutoSize = False
        _lblEditInstructions.MaximumSize = New Size(280, 0)
        _lblEditInstructions.AutoSize = True
        _lblEditInstructions.Margin = New Padding(0, 0, 0, 14)

        _btnDone = New Button()
        _btnDone.Text = "I'm Done"
        _btnDone.Size = New Size(100, 30)
        _btnDone.Margin = New Padding(0, 0, 6, 0)
        _btnDone.FlatStyle = FlatStyle.System
        AddHandler _btnDone.Click, AddressOf OnDoneClick

        _btnCancel = New Button()
        _btnCancel.Text = "Cancel"
        _btnCancel.Size = New Size(80, 30)
        _btnCancel.FlatStyle = FlatStyle.System
        AddHandler _btnCancel.Click, AddressOf OnCancelClick
    End Sub

    ' ==================================================================
    '  Content display helpers
    ' ==================================================================

    Private Sub ShowIdleContent()
        _contentPanel.SuspendLayout()
        _contentPanel.Controls.Clear()

        ' Use FlowLayoutPanel for vertical stacking
        Dim flow As New FlowLayoutPanel()
        flow.FlowDirection = FlowDirection.TopDown
        flow.WrapContents = False
        flow.AutoSize = True
        flow.Dock = DockStyle.Top
        flow.Padding = New Padding(0)

        flow.Controls.Add(_lblIdleTitle)
        flow.Controls.Add(_lblIdleInfo)

        _contentPanel.Controls.Add(flow)
        _contentPanel.ResumeLayout(True)
    End Sub

    Private Sub ShowSketchEditContent()
        _contentPanel.SuspendLayout()
        _contentPanel.Controls.Clear()

        ' Update text for current sketch
        _lblEditSketchName.Text = "Sketch: " & _sketchName

        _lblEditInstructions.Text =
            "Draw a closed perimeter that defines the " &
            "grating outline:" & vbCrLf & vbCrLf &
            ChrW(&H2022) & " Use Lines, Arcs, or Splines" & vbCrLf &
            ChrW(&H2022) & " All curves must connect end-to-end" & vbCrLf &
            ChrW(&H2022) & " The loop must be closed" & vbCrLf & vbCrLf &
            "Click ""I'm Done"" when finished."

        ' Use FlowLayoutPanel for vertical stacking
        Dim flow As New FlowLayoutPanel()
        flow.FlowDirection = FlowDirection.TopDown
        flow.WrapContents = False
        flow.AutoSize = True
        flow.Dock = DockStyle.Top
        flow.Padding = New Padding(0)

        flow.Controls.Add(_lblEditTitle)
        flow.Controls.Add(_lblEditSketchName)
        flow.Controls.Add(_lblEditInstructions)

        ' Button row
        Dim buttonFlow As New FlowLayoutPanel()
        buttonFlow.FlowDirection = FlowDirection.LeftToRight
        buttonFlow.AutoSize = True
        buttonFlow.Margin = New Padding(0, 4, 0, 0)
        buttonFlow.Controls.Add(_btnDone)
        buttonFlow.Controls.Add(_btnCancel)
        flow.Controls.Add(buttonFlow)

        _contentPanel.Controls.Add(flow)
        _contentPanel.ResumeLayout(True)
    End Sub

    ' ==================================================================
    '  Button handlers
    ' ==================================================================

    Private Sub OnDoneClick(sender As Object, e As EventArgs)
        _action = UserAction.Done
        _actionTaken = True
    End Sub

    Private Sub OnCancelClick(sender As Object, e As EventArgs)
        _action = UserAction.Cancel
        _actionTaken = True
    End Sub

End Class
